generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================== Enums ====================
enum Role { 
  MAHASISWA 
  DOSEN 
  ADMIN 
}
enum TypeAbsensi { 
  REMOTE_ABSENSI 
  LOKAL_ABSENSI 
}
enum TypeAnomali { 
  KEHADIRAN_GANDA 
  TIDAK_HADIR_BERULANG 
  POLA_WAKTU_TIDAK_WAJAR
}
enum StatusAnomali {
  OPEN
  REVIEWED
  RESOLVED
}
enum StatusPengajuan {
  MENUNGGU
  DISETUJUI
  DITOLAK
}
enum ParkingType {
  MASUK
  KELUAR
}

// =================== Models ===================
model User {
  id_user        Int              @id @default(autoincrement())
  nama           String
  username       String           @unique
  password       String
  role           Role
  nim_nip        String?          @unique @db.VarChar(20)
  email          String?          @unique
  fcm_token      String?          // Firebase Cloud Messaging device token
  push_notifications_enabled Boolean @default(true)
  profile_picture String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  dataBiometrik  DataBiometrik?
  refreshTokens  RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  kendaraan      Kendaraan[]
  absensi        Absensi[]
  laporanAnomali LaporanAnomali[]
  logParkir      LogParkir[]
  kelasDiampu    Kelas[]          @relation("DosenKelas")
  pesertaKelas   PesertaKelas[]
  posts          Post[]
  postLikes      PostLike[]
  postComments   PostComment[]
  jadwalPengganti JadwalPengganti[] @relation("DosenJadwalPengganti")

  @@index([role], map: "idx_user_role")
  @@index([createdAt], map: "idx_user_created")
  @@index([deletedAt], map: "idx_user_deleted")
  @@map("users")
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  id_user     Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  
  @@index([token], map: "idx_refresh_token")
  @@index([id_user], map: "idx_refresh_user")
  @@index([expiresAt], map: "idx_refresh_expires")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  id_user     Int
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@index([token], map: "idx_reset_token")
  @@index([id_user], map: "idx_reset_user")
  @@map("password_reset_tokens")
}

model DataBiometrik {
  id_biometrik   Int       @id @default(autoincrement())
  id_user        Int       @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  face_embedding Float[]
  photo_url      String?
  user           User      @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@index([createdAt], map: "idx_bio_created")
  @@index([deletedAt], map: "idx_bio_deleted")
  @@map("data_biometrik")
}

model Kendaraan {
  id_kendaraan     Int             @id @default(autoincrement())
  plat_nomor       String          @unique @db.VarChar(20)
  id_user          Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  fotoKendaraan    String[]
  fotoSTNK         String
  statusVerif      Boolean         @default(false)
  feedback         String?
  nama_kendaraan   String          @default("Motor") @db.VarChar(100)
  status_pengajuan StatusPengajuan @default(MENUNGGU)
  user             User            @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  logParkir        LogParkir[]

  @@index([id_user], map: "idx_kendaraan_user")
  @@index([createdAt], map: "idx_kendaraan_created")
  @@index([deletedAt], map: "idx_kendaraan_deleted")
  @@index([status_pengajuan], map: "idx_kendaraan_status")
  @@map("kendaraan")
}

model Parkiran {
  id_parkiran    Int                  @id @default(autoincrement())
  nama_parkiran  String               @unique(map: "uq_parkiran_nama") @db.VarChar(100)
  kapasitas      Int
  live_kapasitas Int                  @default(0)
  koordinat      Unsupported("point")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  logParkir      LogParkir[]

  @@index([kapasitas], map: "idx_parkiran_kapasitas")
  @@index([deletedAt], map: "idx_parkiran_deleted")
  @@map("parkiran")
}

model LogParkir {
  id_log_parkir  Int         @id @default(autoincrement())
  id_kendaraan   Int
  id_parkiran    Int
  id_user        Int?
  timestamp      DateTime    @default(now())
  confidence     Float?
  face_detected  Boolean     @default(false)
  face_image_url String?
  image_url      String?
  type           ParkingType
  kendaraan      Kendaraan   @relation(fields: [id_kendaraan], references: [id_kendaraan], onDelete: Cascade)
  parkiran       Parkiran    @relation(fields: [id_parkiran], references: [id_parkiran])
  user           User?       @relation(fields: [id_user], references: [id_user])

  @@index([id_kendaraan, timestamp], map: "idx_log_kendaraan_ts")
  @@index([id_parkiran, timestamp], map: "idx_log_parkiran_ts")
  @@index([id_user, timestamp], map: "idx_log_user_ts")
  @@index([timestamp], map: "idx_log_ts")
  @@index([type], map: "idx_log_type")
  @@map("log_parkir")
}

model Matakuliah {
  id_matakuliah   Int       @id @default(autoincrement())
  nama_matakuliah String
  kode_matakuliah String    @unique @db.VarChar(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  kelas           Kelas[]

  @@index([nama_matakuliah], map: "idx_mk_nama")
  @@index([deletedAt], map: "idx_mk_deleted")
  @@map("matakuliah")
}

model Semester {
  id_semester   Int       @id @default(autoincrement())
  nama_semester String
  tanggal_mulai DateTime
  tanggal_selesai DateTime
  drop_deadline DateTime
  is_active     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  kelas         Kelas[]

  @@map("semesters")
}

model Kelas {
  id_kelas       Int       @id @default(autoincrement())
  id_matakuliah  Int
  id_dosen       Int
  id_semester    Int       // Wajib — setiap kelas harus terhubung ke semester
  hari           Int?      // 1=Senin, 2=Selasa, 3=Rabu, 4=Kamis, 5=Jumat, 6=Sabtu, 7=Minggu
  jam_mulai      Unsupported("time")
  jam_berakhir   Unsupported("time")
  nama_kelas     String
  ruangan        String
  kapasitas      Int       @default(50)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  matakuliah Matakuliah @relation(fields: [id_matakuliah], references: [id_matakuliah], onDelete: Restrict)
  dosen      User       @relation("DosenKelas", fields: [id_dosen], references: [id_user], onDelete: Restrict)
  semester   Semester   @relation(fields: [id_semester], references: [id_semester], onDelete: Restrict)
  peserta    PesertaKelas[]
  absensi    Absensi[]
  laporan    LaporanAnomali[]
  sesiAbsensi  SesiAbsensi[]
  jadwalPengganti JadwalPengganti[]

  @@index([id_matakuliah, id_dosen], map: "idx_kelas_mk_dosen")
  @@index([ruangan], map: "idx_kelas_ruangan")
  @@index([jam_mulai, jam_berakhir], map: "idx_kelas_waktu")
  @@index([deletedAt], map: "idx_kelas_deleted")
  @@index([hari], map: "idx_kelas_hari")
  @@index([id_semester], map: "idx_kelas_semester")
  @@map("kelas")
}

model JadwalPengganti {
  id_jadwal_pengganti Int       @id @default(autoincrement())
  id_kelas            Int
  tanggal_asli        DateTime
  status              String
  tanggal_ganti       DateTime?
  jam_mulai_ganti     DateTime? @db.Time(6)
  jam_berakhir_ganti  DateTime? @db.Time(6)
  ruangan_ganti       String?
  alasan              String
  createdBy           Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  dosen               User      @relation("DosenJadwalPengganti", fields: [createdBy], references: [id_user])
  kelas               Kelas     @relation(fields: [id_kelas], references: [id_kelas], onDelete: Cascade)

  @@index([id_kelas, tanggal_asli], map: "idx_jadwal_pengganti_kelas_tgl")
  @@index([tanggal_ganti], map: "idx_jadwal_pengganti_tgl_ganti")
  @@map("jadwal_pengganti")
}

model PesertaKelas {
  id_mahasiswa Int
  id_kelas     Int
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  kelas        Kelas     @relation(fields: [id_kelas], references: [id_kelas], onDelete: Cascade)
  mahasiswa    User      @relation(fields: [id_mahasiswa], references: [id_user], onDelete: Cascade)

  @@id([id_mahasiswa, id_kelas], map: "pk_pesertakelas")
  @@index([id_kelas, deletedAt], map: "idx_peserta_kelas")
  @@index([id_mahasiswa, deletedAt], map: "idx_peserta_mahasiswa")
  @@map("peserta_kelas")
}

model SesiAbsensi {
  id_sesi_absensi Int         @id @default(autoincrement())
  id_kelas        Int
  type_absensi    TypeAbsensi
  latitude        Float?
  longitude       Float?
  radius_meter    Int?
  require_face    Boolean     @default(false)
  mulai           DateTime
  selesai         DateTime
  status          Boolean     @default(true)
  createdBy       Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  kelas           Kelas       @relation(fields: [id_kelas], references: [id_kelas])
  absensi         Absensi[]
}

model Absensi {
  id_absensi   Int       @id @default(autoincrement())
  id_user      Int
  id_kelas     Int
  id_sesi_absensi Int
  type_absensi TypeAbsensi
  is_mock_location Boolean @default(false)
  photo_url    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  koordinat    Unsupported("point")

  user             User                 @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  kelas            Kelas                @relation(fields: [id_kelas], references: [id_kelas], onDelete: Cascade)
  sesiAbsensi      SesiAbsensi          @relation(fields: [id_sesi_absensi], references: [id_sesi_absensi])

  @@index([id_user, createdAt], map: "idx_absensi_user_ts")
  @@index([id_kelas, createdAt], map: "idx_absensi_kelas_ts")
  @@index([type_absensi], map: "idx_absensi_type")
  @@index([deletedAt], map: "idx_absensi_deleted")
  @@index([createdAt], map: "idx_absensi_created")
  @@map("absensi")
}

model LaporanAnomali {
  id_anomali   Int           @id @default(autoincrement())
  id_user      Int
  id_kelas     Int?
  type_anomali TypeAnomali
  status       StatusAnomali @default(OPEN)
  catatan_dosen String?      @db.Text
  resolved_at  DateTime?
  deskripsi    String?       @db.Text
  confidence   Float?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  user          User          @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  kelas         Kelas?        @relation(fields: [id_kelas], references: [id_kelas])

  @@index([id_user, type_anomali, createdAt], map: "idx_anomali_user_type_ts")
  @@index([id_kelas, createdAt], map: "idx_anomali_kelas_ts")
  @@index([deletedAt], map: "idx_anomali_deleted")
  @@index([status], map: "idx_anomali_status")
  @@map("laporan_anomali")
}

model Post {
  id_post       Int           @id @default(autoincrement())
  id_user       Int
  content       String
  media         String[]
  latitude      Float?
  longitude     Float?
  location_name String?       @db.VarChar(255)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  comments      PostComment[]
  likes         PostLike[]
  user          User          @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@index([id_user, createdAt], map: "idx_post_user_created")
  @@index([createdAt], map: "idx_post_created")
  @@index([deletedAt], map: "idx_post_deleted")
  @@map("posts")
}

model PostLike {
  id_like   Int      @id @default(autoincrement())
  id_post   Int
  id_user   Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [id_post], references: [id_post], onDelete: Cascade)
  user      User     @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@unique([id_post, id_user], map: "uq_post_user_like")
  @@index([id_post], map: "idx_like_post")
  @@index([id_user], map: "idx_like_user")
  @@map("post_likes")
}

model PostComment {
  id_comment Int       @id @default(autoincrement())
  id_post    Int
  id_user    Int
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  post       Post      @relation(fields: [id_post], references: [id_post], onDelete: Cascade)
  user       User      @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@index([id_post, createdAt], map: "idx_comment_post_created")
  @@index([id_user], map: "idx_comment_user")
  @@index([deletedAt], map: "idx_comment_deleted")
  @@map("post_comments")
}


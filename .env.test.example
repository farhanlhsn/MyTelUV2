# ============================================================
# .env.test.example — Template Konfigurasi Environment Testing
# ============================================================
# Salin file ini menjadi .env.test dan sesuaikan nilainya.
#
#   cp .env.test.example .env.test
#
# File .env.test TIDAK BOLEH dicommit ke repository
# (sudah dikecualikan di .gitignore).
#
# File ini digunakan oleh scripts/test-e2e.sh dan
# scripts/test-e2e.ps1 untuk mengisolasi database test
# dari database development/production.
# ============================================================

# ------ DATABASE ------
# PostgreSQL test container (port 5433, BUKAN port 5432 default)
DATABASE_URL="postgresql://test_user:test_password@localhost:5433/myteluv2_test?schema=public"

# ------ JWT SECRETS (khusus testing — BUKAN nilai production) ------
JWT_SECRET="e2e-testing-super-secret-key-minimum-32-chars"
JWT_REFRESH_SECRET="e2e-testing-refresh-secret-key-minimum-32-chars"

# ------ BACKEND ------
PORT=5050
NODE_ENV="test"

# ------ EDGE DEVICE (gateway parkir) ------
EDGE_DEVICE_SECRET="e2e-testing-edge-device-secret-32-chars"

# ------ AI MICROSERVICES ------
# URL service yang berjalan lokal dalam TEST_MODE
FACE_API_URL="http://localhost:5051"
PLATE_API_URL="http://localhost:5001"
ANOMALY_SERVICE_URL="http://localhost:5003"

# Kunci API untuk autentikasi ke face service
# Kosongkan untuk pengujian lokal (tidak perlu autentikasi)
FACE_API_KEY=""

# ------ FIREBASE (opsional — push notification) ------
# Kosongkan untuk menonaktifkan notifikasi push saat testing
# FIREBASE_SERVICE_ACCOUNT_KEY=""

# ------ CLOUD STORAGE / R2 (opsional — file uploads) ------
# Kosongkan untuk menonaktifkan upload ke Cloudflare R2 saat testing
# R2_ENDPOINT=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""

# ------ CORS ------
# Tidak perlu di test environment, tapi bisa diisi jika diperlukan
# FRONTEND_URL="http://localhost:3000"

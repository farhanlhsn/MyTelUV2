# Server Configuration
PORT=5050
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# PostgreSQL Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/myteluv2"

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Cloudflare R2 Storage
R2_PUBLIC_URL=
R2_ACCESSKEY=
R2_SECRETACCESSKEY=
R2_URL=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=

# Python Face Recognition Service
PYTHON_SERVICE_URL=http://localhost:5051
FACE_SIMILARITY_THRESHOLD=0.6

# Edge Device Authentication (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
EDGE_DEVICE_SECRET=

# Python Service Config
NODEJS_BACKEND_URL=http://localhost:5050

# File Upload
MAX_FILE_SIZE=10485760

# ==================== DATABASE ====================
DATABASE_URL="postgresql://user:password@localhost:5432/myteluv2?schema=public"

# ==================== JWT AUTH ====================
JWT_SECRET="your-jwt-secret-key"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_EXPIRE="7d"
JWT_REFRESH_EXPIRE="30d"

# ==================== CLOUDFLARE R2 STORAGE ====================
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="myteluv2"
R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"

# ==================== AI MICROSERVICES ====================
FACE_API_URL="http://localhost:5051"
PLATE_API_URL="http://localhost:5001"
ANOMALY_SERVICE_URL="http://localhost:5003"

# ==================== EDGE DEVICE ====================
NODEJS_BACKEND_URL="http://localhost:3000"
EDGE_DEVICE_SECRET="your-edge-device-secret"

# ==================== FIREBASE (FCM Push Notifications) ====================
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# ==================== SERVER CONFIG ====================
PORT=3000
NODE_ENV="development"

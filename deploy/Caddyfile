# Docker internal router

:80 {
    # Enable compression
    encode gzip

    # Backend API endpoints
    handle /api/* {
        reverse_proxy backend:5050
    }

    # Face Recognition Service
    handle /face/* {
        uri strip_prefix /face
        reverse_proxy face-recognition:5051
    }

    # Plate Recognition Service
    handle /plate/* {
        uri strip_prefix /plate
        reverse_proxy plate-recognition:5001
    }

    # Anomaly Detection Service
    handle /anomaly/* {
        uri strip_prefix /anomaly
        reverse_proxy anomaly-detection:5003
    }

    # Health check endpoint
    handle /health {
        respond "OK" 200
    }

    # Default response for root
    handle {
        respond "MyTelUV2 API Server" 200
    }

    # Logging
    log {
        output stdout
        format console
    }
}

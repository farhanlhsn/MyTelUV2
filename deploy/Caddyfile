# Docker internal router
#
# Only the backend is reachable through this proxy. The Python AI services (face, plate, anomaly)
# are internal: the backend calls them over the Docker network with X-API-Key, and they are
# deliberately NOT routed here.

# Global options (must be the first block). This Caddy sits behind the host-level reverse proxy,
# which reaches it from a loopback / Docker-gateway address. Trusting private ranges makes Caddy keep
# the X-Forwarded-For chain that proxy sends instead of replacing it with the proxy's own address, so
# the backend sees the real client IP (every per-IP rate limiter depends on it).
{
    servers {
        trusted_proxies static private_ranges
    }
}

:80 {
    # Enable compression
    encode gzip

    # Backend API endpoints
    handle /api/* {
        reverse_proxy backend:5050
    }

    # Realtime (Socket.IO): WebSocket upgrades are proxied transparently by reverse_proxy
    handle /socket.io/* {
        reverse_proxy backend:5050
    }

    # Health check endpoint: answered by the backend (503 when the database is down), so the
    # deploy health check proves the whole chain caddy -> backend -> database, not just caddy
    handle /health {
        reverse_proxy backend:5050
    }

    # Default response for root
    handle {
        respond "MyTelUV2 API Server" 200
    }

    # Logging
    log {
        output stdout
        format console
    }
}
